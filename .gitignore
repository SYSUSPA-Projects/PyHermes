## ignore the generated file
**/*.npy
**/*.bin
examples/output/**
!examples/output/.gitkeep
examples/data/**
!examples/data/.gitkeep
!examples/data/*.yaml
examples/figs/**
!examples/figs/.gitkeep
examples/logs/*.log

## remove the python cache to avoid conflicts
**/__pycache__/

## ignore the generated file when install 
*.egg-info/
.pytest_cache/
build/
dist/
docs/_build/
.DS_Store
.vscode/
tmp/

# Keep private integration assets under tests/ untracked while allowing the
# public unit-test suite to grow normally.
tests/*
!tests/test_*.py
!tests/conftest.py
